{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.mjs",
			"**/*.js",
			"**/*.json",
			"**/*.jsonc",
			"!**/dist",
			"!**/node_modules",
			"!**/.git",
			"!**/scripts",
			"!**/example_configs",
			"!**/config.json",
			"!**/*.config.json",
			"!**/*.sample.json",
			"!**/*.example.json",
			"!**/*.schema.json",
			"!**/.eslintrc.json"
		]
	}
}
