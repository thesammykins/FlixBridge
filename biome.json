{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"files": {
		"ignore": [
			"dist/**",
			"node_modules/**",
			".git/**",
			"scripts/**",
			"example_configs/**",
			"config.json",
			"*.config.json",
			"*.sample.json",
			"*.example.json",
			"*.schema.json",
			".eslintrc.json"
		]
	}
}
