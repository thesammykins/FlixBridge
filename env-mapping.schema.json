{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ARR MCP Environment Variable Mapping Schema",
  "description": "Schema for mapping custom environment variables to ARR MCP configuration",
  "type": "object",
  "properties": {
    "services": {
      "type": "object",
      "description": "Service configurations mapping",
      "properties": {
        "sonarr": {
          "type": "object",
          "description": "Sonarr service environment variable mapping",
          "properties": {
            "baseUrl": {
              "type": "string",
              "description": "Environment variable name containing Sonarr base URL"
            },
            "apiKey": {
              "type": "string",
              "description": "Environment variable name containing Sonarr API key"
            }
          },
          "additionalProperties": false
        },
        "radarr": {
          "type": "object",
          "description": "Radarr service environment variable mapping",
          "properties": {
            "baseUrl": {
              "type": "string",
              "description": "Environment variable name containing Radarr base URL"
            },
            "apiKey": {
              "type": "string",
              "description": "Environment variable name containing Radarr API key"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "downloaders": {
      "type": "object",
      "description": "Downloader configurations mapping",
      "properties": {
        "sabnzbd": {
          "type": "object",
          "description": "SABnzbd downloader environment variable mapping",
          "properties": {
            "baseUrl": {
              "type": "string",
              "description": "Environment variable name containing SABnzbd base URL"
            },
            "apiKey": {
              "type": "string",
              "description": "Environment variable name containing SABnzbd API key"
            },
            "name": {
              "type": "string",
              "description": "Environment variable name containing SABnzbd display name (optional)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "services": {
        "sonarr": {
          "baseUrl": "MCP_SONARR_BASE_URL",
          "apiKey": "MCP_SONARR_API_KEY"
        },
        "radarr": {
          "baseUrl": "MCP_RADARR_BASE_URL",
          "apiKey": "MCP_RADARR_API_KEY"
        }
      },
      "downloaders": {
        "sabnzbd": {
          "baseUrl": "MCP_SABNZBD_BASE_URL",
          "apiKey": "MCP_SABNZBD_API_KEY",
          "name": "MCP_SABNZBD_NAME"
        }
      }
    }
  ]
}
