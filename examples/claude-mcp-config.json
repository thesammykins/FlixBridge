{
	"mcpServers": {
		"flixbridge": {
			"command": "npx",
			"args": ["-y", "@thesammykins/flixbridge"],
			"env": {
				"SONARR_HD_URL": "http://sonarr-hd.example:8989",
				"SONARR_HD_API_KEY": "your-sonarr-hd-api-key-here",
				"SONARR_UHD_URL": "http://sonarr-uhd.example:8989",
				"SONARR_UHD_API_KEY": "your-sonarr-uhd-api-key-here",
				"SONARR_ANIME_URL": "http://sonarr-anime.example:8989",
				"SONARR_ANIME_API_KEY": "your-sonarr-anime-api-key-here",
				"RADARR_HD_URL": "http://radarr-hd.example:7878",
				"RADARR_HD_API_KEY": "your-radarr-hd-api-key-here",
				"RADARR_UHD_URL": "http://radarr-uhd.example:7878",
				"RADARR_UHD_API_KEY": "your-radarr-uhd-api-key-here",
				"SABNZBD_MAIN_URL": "http://sabnzbd-main.example:8080",
				"SABNZBD_MAIN_API_KEY": "your-sabnzbd-main-api-key-here"
			}
		}
	}
}
