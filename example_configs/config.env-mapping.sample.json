{
  "mcpServer": "arr-mcp",
  "command": "node",
  "args": ["dist/index.js"],
  "env": {
    "ARR_MCP_ENV_MAPPING": "{\"services\":{\"sonarr\":{\"baseUrl\":\"MCP_SONARR_BASE_URL\",\"apiKey\":\"MCP_SONARR_API_KEY\"},\"radarr\":{\"baseUrl\":\"MCP_RADARR_BASE_URL\",\"apiKey\":\"MCP_RADARR_API_KEY\"}},\"downloaders\":{\"sabnzbd\":{\"baseUrl\":\"MCP_SABNZBD_BASE_URL\",\"apiKey\":\"MCP_SABNZBD_API_KEY\",\"name\":\"MCP_SABNZBD_NAME\"}}}",
    "MCP_SONARR_BASE_URL": "http://localhost:8989",
    "MCP_SONARR_API_KEY": "your-sonarr-api-key-here",
    "MCP_RADARR_BASE_URL": "http://localhost:7878",
    "MCP_RADARR_API_KEY": "your-radarr-api-key-here",
    "MCP_SABNZBD_BASE_URL": "http://localhost:8080",
    "MCP_SABNZBD_API_KEY": "your-sabnzbd-api-key-here",
    "MCP_SABNZBD_NAME": "SABnzbd"
  }
}
