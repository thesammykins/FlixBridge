{
	"name": "@thesammykins/flixbridge",
	"version": "1.1.0",
	"description": "Media intelligence and human-approved retention MCP for ARR, Plex and Jellyfin",
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"flixbridge": "dist/index.js",
		"flixbridge-retention": "dist/cli.js"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/thesammykins/FlixBridge.git"
	},
	"bugs": {
		"url": "https://github.com/thesammykins/FlixBridge/issues"
	},
	"homepage": "https://github.com/thesammykins/FlixBridge#readme",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/**/*",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc",
		"prepack": "npm run build",
		"dev": "tsx src/index.ts",
		"start": "node dist/index.js",
		"check": "biome check .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"test": "npm run test:unit && npm run test:integration",
		"test:integration": "npm run build && node --test tests/*.test.mjs",
		"test:unit": "tsx tests/run-all.ts",
		"smoke": "tsx scripts/smoke.ts",
		"test:phase2": "tsx scripts/test-phase2.ts",
		"test:queue-diagnostics": "tsx scripts/test-queue-diagnostics.ts",
		"test:slug-config": "tsx scripts/test-slug-config.ts",
		"test:list-services": "tsx scripts/test-list-services.ts",
		"debug:queue": "tsx scripts/debug-queue.ts",
		"test:mcp": "npm run build && node --test tests/mcp-*.test.mjs"
	},
	"keywords": [
		"mcp",
		"media-management",
		"automation",
		"tv-shows",
		"movies",
		"downloads",
		"bridge",
		"ai-assistant"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@modelcontextprotocol/server": "2.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@modelcontextprotocol/client": "2.4.0",
		"@types/node": "26.6.5",
		"tsx": "4.23.15",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
