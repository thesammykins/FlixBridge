{
	"name": "@thesammykins/flixbridge",
	"version": "1.0.1",
	"description": "Media Management MCP Server - environment-only configuration for Sonarr/Radarr/SABnzbd",
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"flixbridge": "dist/index.js"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/thesammykins/FlixBridge.git"
	},
	"bugs": {
		"url": "https://github.com/thesammykins/FlixBridge/issues"
	},
	"homepage": "https://github.com/thesammykins/FlixBridge#readme",
	"publishConfig": {
		"access": "public"
	},
	"files": ["dist/**/*", "README.md", "LICENSE"],
	"scripts": {
		"build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc",
		"prepack": "npm run build",
		"dev": "tsx src/index.ts",
		"start": "node dist/index.js",
		"check": "biome check .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"test": "tsx tests/run-all.ts && npm run test:mcp",
		"test:unit": "tsx tests/run-all.ts",
		"smoke": "tsx scripts/smoke.ts",
		"test:phase2": "tsx scripts/test-phase2.ts",
		"test:queue-diagnostics": "tsx scripts/test-queue-diagnostics.ts",
		"test:slug-config": "tsx scripts/test-slug-config.ts",
		"test:list-services": "tsx scripts/test-list-services.ts",
		"debug:queue": "tsx scripts/debug-queue.ts",
		"test:mcp": "npm run build && node --test tests/mcp-*.test.mjs"
	},
	"keywords": [
		"mcp",
		"media-management",
		"automation",
		"tv-shows",
		"movies",
		"downloads",
		"bridge",
		"ai-assistant"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@modelcontextprotocol/server": "2.3.1",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@modelcontextprotocol/client": "2.3.1",
		"@types/node": "^20.10.0",
		"tsx": "^4.6.0",
		"typescript": "^5.3.0"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
